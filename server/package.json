{
  "name": "custodia-deepfake-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend service for Custodia: runs a local ONNX deepfake classification model using @xenova/transformers and ffmpeg frame extraction for video files.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js"
  },
  "engines": {
    "node": ">=18.11"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.0.2"
  },
  "keywords": ["deepfake", "onnx", "evidence", "custodia", "ai"],
  "author": "Atharva Palande, Krish Pitrola",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pr1meGOD/Custodia.git",
    "directory": "server"
  }
}
