# ─── Custodia Deepfake Detection Server ──────────────────────────
# Copy this file to .env and fill in your values. Never commit .env.

# Server port (default: 4000)
PORT=

# (Optional) Override the local ONNX model name (default: onnx-community/deepfake_vs_real_image_detection-ONNX)
# LOCAL_MODEL_NAME=

# (Optional) HuggingFace API token — only needed if using remote inference (deprecated path)
# Get from https://huggingface.co/settings/tokens
HF_API_TOKEN=

# (Optional) Allowed CORS origins, comma-separated (default: http://localhost:5173,http://127.0.0.1:5173)
# ALLOWED_ORIGINS=
