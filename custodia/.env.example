# ─── Custodia (React / Vite) Frontend ────────────────────────────
# Copy this file to .env and fill in your values. Never commit .env.

# Pinata API key — get from https://app.pinata.cloud/keys
VITE_PINATA_API_KEY=

# Pinata API secret — get from https://app.pinata.cloud/keys
VITE_PINATA_SECRET_API_KEY=

# (Optional) Pinata JWT — alternative to API key/secret pair
# VITE_PINATA_JWT=

# (Optional) Deepfake detection server URL (default: http://localhost:4000/api/check-deepfake)
# VITE_DEEPFAKE_API_URL=
